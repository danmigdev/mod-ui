# Reference settings for Raspberry Pi 4 + Pisound on Patchbox OS 64-bit.
# The build creates integration.env; activate.sh loads that generated file.
# This example is documentation and is not sourced automatically.
# Use systemd EnvironmentFile syntax: NAME=value, without export or shell expansion.

# Override inherited MODEP catalog settings with the current AArch64 catalog.
MOD_PATCHSTORAGE_ENABLED=1
MOD_PATCHSTORAGE_API_URL=https://patchstorage.com/api/beta/patches
MOD_PATCHSTORAGE_PLATFORM_ID=8046
MOD_PATCHSTORAGE_TARGET_ID=8280

# Existing MODEP paths and audio settings are inherited from its service units.
# Keep them when adding local overrides; both hosts must scan the same LV2_PATH.
# LV2_PATH=/var/modep/lv2:/var/modep/lv2-presets
# LV2_PLUGIN_DIR=/var/modep/lv2
# MOD_USER_PLUGINS_DIR=/var/modep/lv2
# MOD_PRESETS_DIR=/var/modep/lv2-presets
# MOD_USER_PEDALBOARDS_DIR=/var/modep/pedalboards
# MOD_USER_FILES_DIR=/var/modep/user-files
# MOD_DATA_DIR=/var/modep
# JACK_PROMISCUOUS_SERVER=jack

# Activation supplies these values, with absolute paths from the selected build.
# MOD_DEV_ENVIRONMENT=0
# MOD_DEV_HMI=1
# MOD_DEV_HOST=0
# MOD_DEVICE_WEBSERVER_PORT=80
# MOD_DEVICE_HOST_PORT=5555
# PYTHONPATH=/absolute/build/mod-ui
# MOD_HTML_DIR=/absolute/build/mod-ui/html
# MOD_DEFAULT_PEDALBOARD=/absolute/build/mod-ui/default.pedalboard

# UI and mod-host continue to run as modep:modep through the existing services.
# authbind retains access to port 80 for Pisound's HTTP controller scripts.

# The official MODEP updater is visible, but does not replace a custom Grid build.
# Rebuild the fork for updates. This explicit opt-in permits package replacement:
# MOD_GRID_ALLOW_PACKAGE_UPGRADE=1
